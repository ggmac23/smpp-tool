{
  "name": "smppclient",
  "version": "0.1.0",
  "description": "Desktop SMPP client for testing SMSCs and aggregators",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "build:main": "tsc -p tsconfig.main.json && npm run build:preload",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --outfile=dist/preload/index.js",
    "build:ui": "cd src/ui && qx compile --target=build && cd ../.. && npm run build:forms",
    "build:forms": "esbuild src/shared/ui/index.ts --bundle --format=iife --global-name=SmppForms --target=es2020 --platform=browser --outfile=compiled/build/forms.js",
    "build": "npm run build:main && npm run build:ui",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "rust:test": "cd src-tauri && cargo test",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@qooxdoo/framework": "7.9.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

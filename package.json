{
  "name": "smppclient",
  "version": "0.1.0",
  "description": "Desktop SMPP client for testing SMSCs and aggregators",
  "main": "dist/main/index.js",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "build:main": "tsc -p tsconfig.main.json",
    "build:ui": "cd src/ui && qx compile --target=build",
    "build": "npm run build:main && npm run build:ui",
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@qooxdoo/framework": "7.9.3",
    "@types/node": "^24.0.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
